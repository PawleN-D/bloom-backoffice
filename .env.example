# Public base URL for the Fastify backend used in browser contexts.
# Example: https://api.bloom.ie
NEXT_PUBLIC_API_URL=

# Indicates this is the HQ app for super-admin theming.
NEXT_PUBLIC_APP_ENV=HQ

# Public base URL for the main Bloom app (used to build org URLs).
# Example: https://bloom-c6u.pages.dev
NEXT_PUBLIC_APP_BASE_URL=

# Base domain for organization subdomains (e.g., org.bloom.com).
NEXT_PUBLIC_ORG_DOMAIN=bloom.com

# Server-side base URL for proxying to Fastify.
# Example: http://localhost:3001 or https://api.bloom.ie
BACKEND_API_BASE_URL=

# Optional cookie domain, e.g. .bloom.ie for subdomain sharing.
AUTH_COOKIE_DOMAIN=
