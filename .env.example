# Public base URL for client-side requests. Leave blank to use relative /api routes.
NEXT_PUBLIC_API_BASE_URL=

# Server-side base URL for proxying to Fastify (required for auth + API proxy).
# Example: http://localhost:3001 or https://api.bloom.ie
BACKEND_API_BASE_URL=

# Optional cookie domain, e.g. .bloom.ie for subdomain sharing.
AUTH_COOKIE_DOMAIN=
